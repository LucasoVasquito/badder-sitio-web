# Copiá este archivo como .env.local (desarrollo) o cargá las variables en
# Netlify → Site configuration → Environment variables (producción).
# IMPORTANTE: todo lo que empieza con VITE_ queda visible en el navegador.
# Nunca pongas acá claves privadas, tokens ni datos bancarios.

# --- Contacto ---
# URL pública que recibe el formulario de /contact (POST JSON: name, email, subject, message)
# y responde 2xx solo si el mensaje se guardó o se reenvió.
# Vacío = el formulario abre la app de correo del usuario (no simula envíos).
VITE_CONTACT_ENDPOINT=

# --- Compras online ---
# El checkout se habilita SOLO si las dos variables están completas.
# El endpoint recibe POST JSON { customer, items[{productId, sku, quantity, unitPrice}], total }
# y debe responder 2xx con { "ok": true, "reference": "..." } cuando el pedido quedó registrado.
VITE_CHECKOUT_ENABLED=false
VITE_ORDER_ENDPOINT=
